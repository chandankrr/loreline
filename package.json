{
  "name": "loreline",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "clean": "turbo run clean && rm -rf .turbo && rm -rf node_modules",
    "dev": "turbo dev",
    "format": "biome format --write .",
    "format:all": "biome check --write --unsafe --no-errors-on-unmatched",
    "lint": "turbo run lint --",
    "prepare": "husky",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.8.0",
    "@loreline/openapi": "workspace:*",
    "@loreline/ui": "workspace:*",
    "@loreline/zod": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@ts-rest/core": "^3.52.1",
    "axios": "^1.20.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "ts-pattern": "^5.9.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
