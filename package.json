{
  "name": "loreline",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "clean": "turbo run clean && rm -rf .turbo && rm -rf node_modules",
    "dev": "turbo dev",
    "format": "biome format --write .",
    "format:all": "biome check --write --unsafe --no-errors-on-unmatched",
    "lint": "turbo run lint --",
    "prepare": "husky",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@loreline/typescript-config": "workspace:*",
    "@biomejs/biome": "2.5.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
