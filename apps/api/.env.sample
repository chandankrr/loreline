LORELINE_PRIMARY.ENV="local"

LORELINE_SERVER.PORT="8080"
LORELINE_SERVER.READ_TIMEOUT="30"
LORELINE_SERVER.WRITE_TIMEOUT="30"
LORELINE_SERVER.IDLE_TIMEOUT="60"
LORELINE_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

LORELINE_DATABASE.HOST="localhost"
LORELINE_DATABASE.PORT="5432"
LORELINE_DATABASE.USER="postgres"
LORELINE_DATABASE.PASSWORD=""
LORELINE_DATABASE.NAME="loreline"
LORELINE_DATABASE.SSL_MODE="disable"
LORELINE_DATABASE.MAX_OPEN_CONNS="25"
LORELINE_DATABASE.MAX_IDLE_CONNS="25"
LORELINE_DATABASE.CONN_MAX_LIFETIME="300"
LORELINE_DATABASE.CONN_MAX_IDLE_TIME="300"

LORELINE_AUTH.SECRET_KEY="secret"

LORELINE_INTEGRATION.RESEND_API_KEY="resend_key"

LORELINE_REDIS.ADDRESS="localhost:6379"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
LORELINE_OBSERVABILITY.SERVICE_NAME="loreline"
LORELINE_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
LORELINE_OBSERVABILITY.LOGGING.LEVEL="debug"
LORELINE_OBSERVABILITY.LOGGING.FORMAT="console"
LORELINE_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
LORELINE_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LORELINE_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
LORELINE_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
LORELINE_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
LORELINE_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
LORELINE_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
LORELINE_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
LORELINE_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"
